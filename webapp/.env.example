# Публичные переменные Vite/SvelteKit (префикс PUBLIC_).
# Локально: /api → vite proxy на backend :8000 (API_PROXY_TARGET).
PUBLIC_API_BASE=/api

# Опционально: куда проксировать /api в `npm run dev` / preview.
# API_PROXY_TARGET=http://127.0.0.1:8000

# Ключ Яндекс.Карт (карта в chat_link).
# VITE_YANDEX_MAPS_API_KEY=
