APP_ENVIRONMENT=local
CLOUDPUB_AGENT_ID=cc9d4150-d529-48e0-93c2-ff8ba5c56fd8

# Секреты и локальные переопределения конфигурации.
MAX_BOT_TOKEN=...
CLOUDPUB_TOKEN=...

# Публичный ключ Yandex Maps JS API 3.0; ограничьте его по HTTP Referer.
VITE_YANDEX_MAPS_API_KEY=...

# KAN notify: по умолчанию выключено, чтобы не спамить demo.
NOTIFY_ENABLED=false
SUMMARIZER_PROVIDER=none
# Заполняется только для выбранного внешнего провайдера суммаризации.
# Для DeepSeek через AITUNNEL ключ AITUNNEL_API_KEY имеет приоритет над прямым API.
AITUNNEL_API_KEY=
AITUNNEL_MODEL=deepseek-v4-flash-0731
DEEPSEEK_API_KEY=
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
